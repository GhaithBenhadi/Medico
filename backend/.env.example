# ── Supabase ──────────────────────────────────────────────
# Dashboard → Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...     # anon / public key
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6...   # service_role key (secret)
SUPABASE_JWT_SECRET=your-jwt-secret                      # Dashboard → Settings → API → JWT Secret

# ── Serveur ───────────────────────────────────────────────
NODE_ENV=production
PORT=3001                       # Railway le gère automatiquement
FRONTEND_URL=https://ton-domaine.vercel.app

# ── Emails (optionnel) ────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=notifications@tondomaine.fr
